# 이 파일을 .env 로 복사해서 쓰세요. (.env 는 Git 에 올라가지 않습니다)
# 전부 선택 사항입니다. 비워 두면 키 없이 동작하는 경로를 씁니다.

# YouTube Data API v3 키 — 있으면 검색·통계를 공식 API로, 없으면 공개 페이지에서 읽습니다.
YOUTUBE_API_KEY=

# AI 초안용 (하나만 있으면 됨). 없으면 이 PC의 hermes CLI(hermes -z)를 씁니다.
ANTHROPIC_API_KEY=
# Claude 키를 Workspace 를 정하지 않고 만들었다면 그 Workspace ID(wrkspc_…)를 넣으세요. (Workspace 를 정해 만든 키면 비워 둠)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
